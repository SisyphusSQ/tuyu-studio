# Generated by init_harness_project.sh

# Base
.DS_Store
.idea/
.vscode/
*.swp
*.swo
*.log
logs/
tmp/
temp/
**/output/
.superpowers/

# Local-only automation/runtime surfaces for Symphony dogfood.
docs/symphony/

# Local-only execution plans; canonical execution docs live in Linear.
.agents/plans/

# Harness local auxiliary run surfaces
.agents/state/*
!.agents/state/TEMPLATE.md
.agents/runs/*
!.agents/runs/TEMPLATE.md

# Cursor project rules are commit-safe; other Cursor files stay local by default.
.cursor/*
!.cursor/rules/
!.cursor/rules/*.mdc

# Go
bin/
build/
*.test
*.out
coverage.out
coverage.html

# Frontend / Wails generated runtime outputs
node_modules/
frontend/node_modules/
frontend/dist/*
!frontend/dist/.gitkeep
frontend/package.json.md5
